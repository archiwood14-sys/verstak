<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Бот «АРХИВУД Документы»: работает всегда, после сбоя запускается заново.
  Установка:
    cp ru.archiwood.dokumenty.bot.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ru.archiwood.dokumenty.bot.plist
  Перезапуск:  launchctl kickstart -k gui/$(id -u)/ru.archiwood.dokumenty.bot
  Остановка:   launchctl bootout gui/$(id -u)/ru.archiwood.dokumenty.bot
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ru.archiwood.dokumenty.bot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Users/ulia/archiwood_proekty/dokumenty/bot.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/ulia/archiwood_proekty/dokumenty</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>LANG</key>
		<string>ru_RU.UTF-8</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- не чаще одного перезапуска в 30 секунд, если бот падает сразу (например, нет ключа) -->
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/ulia/archiwood_proekty/dokumenty/bot.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ulia/archiwood_proekty/dokumenty/bot.err.log</string>
</dict>
</plist>
